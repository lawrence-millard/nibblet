{
  "name": "@nibble/mcp",
  "version": "0.1.0",
  "description": "Free MCP catalog server for Nibble — list, search, and emit zero-env install configs.",
  "type": "module",
  "bin": {
    "nibble-mcp": "./src/index.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js"
  },
  "files": [
    "src",
    "data",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nibble",
    "catalog"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
